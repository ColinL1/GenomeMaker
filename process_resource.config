/*
 * ============================================================
 * process_resource.config
 * Per-process cpus / memory / time for the whole pipeline.
 * ============================================================
 */

process {
    // ---- shared resource shapes (withLabel) ----
    // OMARK, STRINGTIE_ASSEMBLE
    withLabel: res_anno_qc      { cpus = { 16 * task.attempt }; memory = { 32.GB * task.attempt }; time = { 12.h * task.attempt } }
    // FUNANNOTATE_SORT, GFASTATS_QC
    withLabel: res_light        { cpus = { 4 * task.attempt }; memory = { 8.GB * task.attempt }; time = { 2.h * task.attempt } }
    // BLOBTOOLS_APPLY_FILTER, QUAST_QC
    withLabel: res_mid_4h       { cpus = { 4 * task.attempt }; memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt } }
    // MERGE_ANNOTATIONS, MERYL_HIST
    withLabel: res_mid_6h       { cpus = { 4 * task.attempt }; memory = { 16.GB * task.attempt }; time = { 6.h * task.attempt } }
    // PURGE_DUPS_COVERAGE, PURGE_DUPS_RUN
    withLabel: res_purge_dups   { cpus = { params.threads_default * task.attempt }; memory = { 32.GB * task.attempt }; time = { 8.h * task.attempt } }
    // FASTQC, MITO_READ_FILTER, MULTIQC, NANOPLOT, NANOSTAT
    withLabel: res_read_tool   { cpus = { 12 * task.attempt }; memory = { 24.GB * task.attempt }; time = { 6.h * task.attempt } }
    // BLOBTOOLS_ADD_BUSCO, BLOBTOOLS_ADD_COV, BLOBTOOLS_CREATE
    withLabel: res_small        { cpus = { 2 * task.attempt }; memory = { 8.GB * task.attempt }; time = { 1.h * task.attempt } }
    // BLOBTOOLS_ADD_HITS, GENERATE_SUMMARY, GENOMESCOPE
    withLabel: res_small_2h     { cpus = { 2 * task.attempt }; memory = { 8.GB * task.attempt }; time = { 2.h * task.attempt } }
    // COMBINE_COMPARISON, MITO_COVERAGE_STATS, MULTIQC_FINAL
    withLabel: res_tiny         { cpus = { 2 * task.attempt }; memory = { 4.GB * task.attempt }; time = { 1.h * task.attempt } }

    // ---- bespoke, one per process (withName) ----
    // Porechop holds every read in memory: 60 GB peak for 8.5 M reads (14.5 GB fastq.gz).
    // It must pass on attempt 1: -resume does not find a task that passed on a retry
    // once earlier launches have failed it.
    withName: PORECHOP                 { cpus = { 12 * task.attempt }; memory = { 80.GB * task.attempt }; time = { 6.h * task.attempt } }
    withName: ASSEMBLE_FLYE            { cpus = { params.resource_flye_cpus * task.attempt }; memory = { params.resource_flye_memory * task.attempt }; time = { params.resource_flye_time * task.attempt } }
    withName: ASSEMBLE_HIFIASM         { cpus = { params.resource_hifiasm_cpus * task.attempt }; memory = { params.resource_hifiasm_memory * task.attempt }; time = { params.resource_hifiasm_time * task.attempt } }
    withName: ASSEMBLE_NECAT           { cpus = { params.resource_necat_cpus * task.attempt }; memory = { params.resource_necat_memory * task.attempt }; time = { params.resource_necat_time * task.attempt } }
    withName: ASSEMBLE_RAVEN           { cpus = { params.resource_raven_cpus * task.attempt }; memory = { params.resource_raven_memory * task.attempt }; time = { params.resource_raven_time * task.attempt } }
    withName: BARRNAP_RRNA             { cpus = { 12 * task.attempt }; memory = { 8.GB * task.attempt }; time = { 4.h * task.attempt } }
    // Peak RSS (~224 GB) is reclaimable mmapped database page cache; this is the real working set.
    withName: BLASTN_NT              { cpus = { params.threads_blastn }; memory = { 32.GB * task.attempt }; time = { 24.h * task.attempt } }
    // braker4_executor = 'slurm': the task only coordinates; the rules get their own SLURM jobs
    withName: BRAKER4_RUN              { cpus = { params.braker4_executor == 'slurm' ? 2 : params.threads_braker * task.attempt }; memory = { params.braker4_executor == 'slurm' ? 8.GB * task.attempt : params.resource_braker_memory * task.attempt }; time = { params.resource_braker_time * task.attempt } }
    withName: 'BUSCO_ASSEMBLY|BUSCO_NUCLEAR' { cpus = { params.threads_busco * task.attempt }; memory = { 64.GB * task.attempt }; time = { 48.h * task.attempt } }
    withName: BUSCO_FINAL              { cpus = { params.threads_busco * task.attempt }; memory = { params.resource_busco_final_memory * task.attempt }; time = { params.resource_busco_final_time * task.attempt } }
    withName: CHOPPER_HQ_READS         { cpus = { 16 * task.attempt }; memory = { 80.GB * task.attempt }; time = { 8.h * task.attempt } }
    withName: CHOPPER_SPLIT            { cpus = { 16 * task.attempt }; memory = { 80.GB * task.attempt }; time = { 8.h * task.attempt } }
    withName: COMBINE_REPEAT_DB        { cpus = { 16 * task.attempt }; memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt } }
    withName: COMPLEASM                { cpus = { params.threads_busco }; memory = { 64.GB * task.attempt }; time = { 24.h * task.attempt } }
    withName: DIAMOND_BLASTX           { cpus = { params.threads_diamond }; memory = { 120.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: EDTA_RUN                 { cpus = { 128 * task.attempt }; memory = { 250.GB * task.attempt }; time = { 48.h * task.attempt } }
    withName: EGGNOG_MAPPER            { cpus = { params.threads_funannotate * task.attempt }; memory = { params.resource_eggnog_memory * task.attempt }; time = { params.resource_eggnog_time * task.attempt } }
    withName: FUNANNOTATE_ANNOTATE     { cpus = { params.threads_funannotate_annotate * task.attempt }; memory = { params.resource_funannotate_memory * task.attempt }; time = { params.resource_funannotate_time * task.attempt } }
    withName: GT_GFF3_VALIDATE         { cpus = 2; memory = { 8.GB * task.attempt }; time = { 2.h * task.attempt } }
    withName: INFERNAL_CMSCAN          { cpus = { 32 * task.attempt }; memory = { 32.GB * task.attempt }; time = { 48.h * task.attempt } }
    withName: INTERPROSCAN             { cpus = { params.threads_interproscan * task.attempt }; memory = { params.resource_iprscan_memory * task.attempt }; time = { params.resource_iprscan_time * task.attempt } }
    withName: 'MEDAKA_POLISH|MEDAKA_GAPFILL' { cpus = { params.resource_medaka_cpus * task.attempt }; memory = { params.resource_medaka_memory * task.attempt }; time = { params.resource_medaka_time * task.attempt } }
    withName: MERGE_BAMS               { cpus = { params.threads_star * task.attempt }; memory = { 32.GB * task.attempt }; time = { 6.h * task.attempt } }
    withName: MERQURY_QV               { cpus = { params.threads_default * task.attempt }; memory = { 64.GB * task.attempt }; time = { 8.h * task.attempt } }
    withName: MERYL_COUNT              { cpus = { 16 * task.attempt }; memory = { 64.GB * task.attempt }; time = { 24.h * task.attempt } }
    withName: MINIMAP2_SORT            { cpus = { params.threads_default * task.attempt }; memory = { 64.GB * task.attempt }; time = { 16.h * task.attempt } }
    withName: MITO_MAPPING             { cpus = { params.threads_default * task.attempt }; memory = { 32.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: MITO_GETORGANELLE        { cpus = { 64 * task.attempt }; memory = { 64.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: PASSTHROUGH              { cpus = { 1 * task.attempt }; memory = { 4.GB * task.attempt }; time = { 1.h * task.attempt } }
    withName: PHOBIUS_RUN              { cpus = { 4 * task.attempt }; memory = { 8.GB * task.attempt }; time = { 4.h * task.attempt } }
    withName: POLISH_QC_GATE           { cpus = 1; memory = { 2.GB * task.attempt }; time = { 30.m * task.attempt } }
    withName: PREPARE_BLAST_QUERY      { cpus = 4; memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt } }
    withName: RANK_ASSEMBLIES          { cpus = { 2 * task.attempt }; memory = { 4.GB * task.attempt }; time = { 30.m * task.attempt } }
    withName: REPEATMASKER_RUN         { cpus = { 64 * task.attempt }; memory = { 32.GB * task.attempt }; time = { 24.h * task.attempt } }
    withName: REPEATMODELER            { cpus = { 64 * task.attempt }; memory = { 64.GB * task.attempt }; time = { 72.h * task.attempt } }
    withName: RNASEQ_TRIM              { cpus = { params.threads_default * task.attempt }; memory = { 32.GB * task.attempt }; time = { 6.h * task.attempt } }
    withName: PARSE_GENOME_SIZE      { cpus = 1; memory = { 2.GB * task.attempt }; time = { 20.m * task.attempt } }
    withName: COLLATE_VERSIONS        { cpus = 1; memory = { 2.GB * task.attempt }; time = { 20.m * task.attempt } }
    withName: STAR_GENOME_INDEX        { cpus = { params.threads_star * task.attempt }; memory = { 64.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: STAR_MAPPING             { cpus = { params.threads_star * task.attempt }; memory = { 48.GB * task.attempt }; time = { 12.h * task.attempt } }
    // Only the read mapping is multi-threaded; the fill step is single-threaded (130 GB peak, Porites)
    withName: TGS_GAPFILL              { cpus = { params.resource_gapfill_cpus * task.attempt }; memory = { params.resource_gapfill_memory * task.attempt }; time = { params.resource_gapfill_time * task.attempt } }
    withName: TRNASCAN_SE              { cpus = { 16 * task.attempt }; memory = { 16.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: WRITE_META_YAML          { cpus = 1; memory = { 1.GB * task.attempt }; time = { 10.m * task.attempt } }

    // Screens, scaffolding, refinement and release (values from the v1.0 release run)
    withName: VECSCREEN                { cpus = 32; memory = { 16.GB * task.attempt }; time = { 6.h * task.attempt } }
    withName: FCS_GX                   { cpus = 48; memory = 600.GB; time = { 12.h * task.attempt } }   // memory set by the GX database size, not the input
    withName: RAGTAG_SCAFFOLD          { cpus = 32; memory = { 64.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: DIAMOND_BLASTP           { cpus = 64; memory = { 200.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: DIAMOND_ISOFORMS         { cpus = 64; memory = { 64.GB * task.attempt }; time = { 4.h * task.attempt } }
    withName: REPEAT_CLASSIFY          { cpus = 64; memory = { 100.GB * task.attempt }; time = { 48.h * task.attempt } }
    withName: FUNANNOTATE_NCBI         { cpus = { params.threads_funannotate_annotate * task.attempt }; memory = { params.resource_funannotate_memory * task.attempt }; time = { params.resource_funannotate_time * task.attempt } }
    withName: SYMBIONT_BUSCO           { cpus = { params.threads_busco * task.attempt }; memory = { 32.GB * task.attempt }; time = { 12.h * task.attempt } }
}
