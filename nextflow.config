/*
 * Global configuration for Coral Genome Assembly & Annotation Pipeline
 *
 * Profiles:
 *   binac2  — SLURM + Apptainer (production HPC)
 *   local   — Local executor + Apptainer (development/testing)
 *   conda   — Local executor + conda envs (no Apptainer available)
 *   test    — Local executor, dummy inputs; use with -stub
 *
 * Design:
 *   process_resource.config  -- ALL per-process cpus/memory/time, as withLabel
 *                               tiers for processes that share a resource shape
 *                               plus withName blocks for the bespoke ones.
 *                               Retune a cluster there, never in modules.
 *   this file                -- params, the retry policy, reporting, and the
 *                               executor/container settings that differ per profile.
 *
 * Modules declare only `label` and their tool/container.
 */

// ===========================
// Per-process resources live in their own file so they can be retuned for a
// different cluster without touching any module. Loaded FIRST; every entry that
// references params is a closure, so params defined below are resolved lazily at
// task-submission time rather than at parse time.
// ===========================
includeConfig 'process_resource.config'

params {
    // ===========================
    // Core inputs
    // ===========================
    ont_raw_reads         = 'Por_GA_15_allrun.fastq.gz' //'/pfs/10/work/kn_pop537927-SNP_por_ID/custom_ass_pipe/results/ONT_reads_pc.fastq.gz'
    input_assembly        = null          // path to a pre-made fasta assembly; optional
    outdir                = 'results'
    symbiont_refs         = null          // comma-separated paths, or null → auto-download
    taxon_id              = 46719         // Default taxon ID for BlobTools
    // BlobToolKit taxon names, plus the FIELD each is matched against. The rank
    // differs per category and must: Cnidaria is a phylum, Symbiodiniaceae is a
    // family. Matching both against bestsumorder_phylum made the symbiont filter
    // match zero records, which aborted the run on the zero-match guard.
    host_taxon_name       = 'Cnidaria'
    host_taxon_rank       = 'bestsumorder_phylum'
    symbiont_taxon_name   = 'Symbiodiniaceae'
    symbiont_taxon_rank   = 'bestsumorder_family'
    // OPTIONAL manual selection: one JSON list file exported from the BlobtoolKit
    // Viewer (`blobtools view --remote btk`, run on the published
    // 03_filtering/blobtools/btk). Replaces the automatic taxon filter for the
    // host assembly. null = automatic taxon filters (above).
    filter_json           = null
    // Automatic best-hit filter (default ON): host keeps Cnidaria + no-hit,
    // symbiont keeps Symbiodiniaceae, every other hit is dropped. With
    // auto_filter=false and filter_json=null nothing is filtered; the BlobDir is
    // still produced and published for manual review.
    auto_filter           = true
    mito_ref              = "${projectDir}/config/mito-Plut_OY283138.1.fasta"          // path to mitogenome ref, or null → auto-download from taxon_id
    mito_genetic_code     = 4          // NCBI translation table for mitogenome annotation (4 = Coelenterate mitochondrial)
    // Final mitogenome (stage 05). With Illumina shotgun DNA of the SAME individual the
    // mitogenome is assembled by GetOrganelle; without it, the ONT mito contig (MitoHiFi)
    // is polished by Medaka with the mito-mapped ONT reads of mean quality >= mito_polish_min_q.
    // Lists are comma-separated; R1 and R2 must be in the same order (runs are concatenated).
    illumina_dna_r1       = null
    illumina_dna_r2       = null
    mito_polish_min_q     = 20
    getorganelle_db_dir   = "${projectDir}/config/getorganelle_db"     // animal_mt database, downloaded on first use
    // Annotated related mitogenome for the liftover (RefSeq P. lutea). null -> MITOS2 only.
    mito_annot_ref_fasta  = "${projectDir}/config/mito_ref/NC_029695.1.fasta"
    mito_annot_ref_gff    = "${projectDir}/config/mito_ref/NC_029695.1.gff3"
    // RNA-seq pool: 12 colonies from GA/GT/GL/BST at 28 and 36 C with mismatch
    // <=3.5% and >=0.7 M uniquely mapped reads (~25 M unique in total).
    rnaseq_dir            = "${projectDir}/config/rna_dir_pool"
    trimmomatic_adapters  = "${projectDir}/config/all_truseq_edited.fasta"
    // OrthoDB v12 Metazoa partition (as in P. harrisoni). Used only by BRAKER4_RUN.
    protein_refs          = "${projectDir}/config/Metazoa.fa"
    // MultiQC config controlling module order and section titles so the integrated
    // report reads top-to-bottom in pipeline order rather than grouped by tool.
    multiqc_config        = "${projectDir}/assets/multiqc_config.yaml"

    // ===========================
    // Assembly
    // ===========================
    assemblers            = ['flye','hifiasm','raven'] //['necat']     // ['necat','flye','hifiasm','raven']
    necat_config          = "${projectDir}/config/necat_config"
    necat_path_bin        = "${projectDir}/config/bin/NECAT/Linux-amd64/bin"
    necat_read_list       = "${projectDir}/config/necat_read_list.txt"
    genome_size           = null          // auto-detected from k-mer if null
    kmer_size             = 21
    // Ploidy for the GenomeScope2 model. Corals are diploid and highly heterozygous.
    ploidy                = 2
    // Minimum read quality for the k-mer counting read set only (CHOPPER_HQ_READS).
    // Does NOT affect the assembly or polishing read sets.
    kmer_min_quality      = 15

    // ===========================
    // Annotation
    // ===========================
    busco_lineage         = 'anthozoa_odb12'
    // Assembler ranking (bin/rank.py):
    //   busco_tie_band -- BUSCO score difference in percentage points treated as a
    //     tie, within which N50 decides.
    //   assembly_size_tolerance -- fractional deviation from the GenomeScope2 estimate
    //     before an assembly is flagged a size outlier and ranked behind the rest.
    busco_tie_band        = 0.5
    assembly_size_tolerance = 0.30
    busco_offline_dir     = "${projectDir}/config/busco_db"   // path to local BUSCO lineage datasets, or null → online download
    // Inferred from the STAR BAMs: only 1-2% of spliced R1 reads lie on
    // the transcript strand (XS tag) in both samples -> reverse-stranded (dUTP).
    // Not used by BRAKER4 (it takes the strand from the BAM's XS tags).
    rnaseq_strandedness   = 'reverse' // 'unstranded' | 'forward' | 'reverse'
    funannotate_db        = "${projectDir}/config/funannotate_DB"
    // BUSCO set for `funannotate annotate` only: must exist inside funannotate_db.
    // funannotate 1.x supports only its odb9-era sets (metazoa, dikarya); no
    // 1.x release supports odb12 (1.8.17 checked).
    funannotate_busco_db  = 'metazoa'
    // eggNOG-mapper's own database -- NOT the funannotate one.
    eggnog_db             = "${projectDir}/config/eggnog_DB"
    // --- InterProScan. The ~45 GB analysis data always comes from the host; the
    // --- question is only where the SOFTWARE comes from.
    //
    // PORTABLE DEFAULT: leave interproscan_dir = null and set interproscan_data to
    // a data directory whose release MATCHES interproscan_container. InterProScan
    // refuses to run on mismatched software/data versions.
    //
    // LOCAL OVERRIDE: interproscan_dir points at a complete existing install, and
    // the container is bypassed.
    //
    // Container mode is recommended: a local 5.63-95.0 install segfaulted in its
    // CDD binaries (rpsblast/rpsbproc, exit 139). Prepare the matching data once
    // with setup.py in the same image (5.73-104.0 data from EBI tested).
    interproscan_container = 'interpro/interproscan:5.73-104.0'
    interproscan_data      = null          // InterProScan data dir matching interproscan_container (e.g. interproscan-5.73-104.0/data)
    interproscan_dir       = null
    // Phobius is licence-restricted, so it is installed from the local licensed
    // tarball rather than pulled. phobius.pl self-locates via FindBin, so the whole
    // directory must be staged together.
    run_phobius           = true
    phobius_dir           = "${projectDir}/config/phobius"

    // --- Annotation QC / ncRNA (the additive parts of BRAKER4; see
    //     modules/07b_annotation_qc.nf). Each is skipped when its database is
    //     absent, the same pattern as interproscan_data. ---
    // compleasm lineage download dir. NOT the BUSCO db -- compleasm uses its own
    // format. null lets compleasm download, which needs egress.
    compleasm_db          = null
    // OMAmer database for OMArk -- the INDEPENDENT completeness metric. BRAKER is
    // run with --busco_lineage, which uses compleasm to pick the TSEBRA mode that
    // MAXIMISES BUSCO, so BRAKER's own BUSCO is optimised against the metric and
    // cannot be reported as unbiased. OMArk is outside that loop, and also reports
    // contamination, which matters for a coral holobiont.
    omamer_db             = "${projectDir}/config/omamer/Metazoa.h5"
    // Rfam covariance models for Infernal ncRNA annotation. Without these the GFF3
    // contains tRNAs (tRNAscan-SE) and rRNAs (barrnap) and NOTHING else -- no
    // snRNA, snoRNA, miRNA or riboswitches. Rfam.cm must be cmpress'd before use.
    rfam_cm               = "${projectDir}/config/rfam/Rfam.cm"
    rfam_clanin           = "${projectDir}/config/rfam/Rfam.clanin"
    // Rfam family table (same release as Rfam.cm: 15.1); its type column decides
    // which Infernal hits enter the annotation as ncRNA/rRNA genes.
    rfam_family           = "${projectDir}/config/rfam/family.txt"
    // Reference-guided StringTie transcript assembly (needs no database).
    run_stringtie         = true
    species_name          = 'Porites_sp'
    // BRAKER4 (structural annotation). A checkout of Gaius-Augustus/BRAKER4 pinned
    // at f087ed0 (v0.5.0-beta-19), and a Snakemake 8.18.2 + pandas env created with mamba. BRAKER4 uses busco_lineage.
    braker4_dir               = "${projectDir}/.braker4/BRAKER4"
    braker4_snakemake_env     = "${projectDir}/.conda_envs/braker4_snakemake"
    // Skip contigs shorter than this for gene prediction (BRAKER4 default 10000).
    braker4_min_contig        = 0
    // Scaffold rename prefix for `funannotate sort` (scaffold_1..N). <base>_<N> must be
    // <= 16 chars (NCBI/GenBank limit, enforced by funannotate).
    scaffold_basename     = 'scaffold'
    // Annotation release version, used in the GFF3 filename.
    annotation_version    = '1.0'
    blast_db              = "/share/databases/blast/core_nt"
    diamond_db            = "${projectDir}/config/uniprot/uniprot/reference_proteomes.dmnd"

    // --- BLASTN query windowing (see modules/03_assembly_filtering.nf) ---
    // Scaffolds >= blast_window_min_len are cut into overlapping windows so
    // that blastn -mt_mode 1 has many query records to parallelise over.
    // Overlap = blast_window_size - blast_window_step (10 kb by default);
    // any HSP shorter than the overlap is fully contained in some window,
    // which is what prevents boundary truncation. Raising the overlap costs
    // duplicated search; lowering it risks splitting long alignments.
    // NOTE: windowing changes results (E-value scaling and the per-query
    // -max_target_seqs cap). Set blast_window_min_len very high to disable.
    // Measured on this assembly: scaffolds #1-14 are 18.1-47.5 Mb and #15
    // drops to 375 kb -- a 48x gap -- so anything in 0.5-18 Mb selects
    // exactly the 14 chromosome-scale scaffolds. 5 Mb sits in that gap and
    // states the intent ("chromosome-scale only") without being brittle.
    blast_window_min_len  = 5000000
    blast_window_size     = 110000
    blast_window_step     = 100000

    // Chunk size for the WINDOWED blastn query.
    //
    // Each invocation pays a fixed single-threaded database startup (it scales with
    // the volume count; core_nt has 80 volumes), while the search itself scales with
    // the query size. Nextflow runs a work QUEUE, not waves, so larger chunks save
    // little startup but make the trailing chunk -- which nothing can overlap --
    // proportionally longer. The optimum is about sqrt(Q*S*threads/(P*M)) for query
    // size Q, startup S, P parallel slots and search cost M per MB; a few MB in
    // practice, until startup dominates.
    //
    // E-values scale with the search space, so the database choice belongs in the
    // methods. BlobTools ranks by BITSCORE, which is search-space independent.
    blastn_chunk_size     = 5.MB

    // Chunk size for the WINDOWED diamond blastx query -- 8x blastn's, and
    // MEASURED, not guessed. See the cost table in modules/03_assembly_filtering.nf.
    // diamond's per-invocation startup is ~12.6 min while the search itself costs only
    // ~4 s/MB, so cost is almost all fixed and bigger chunks amortise it:
    //     5 MB -> 1.53 min/MB      40 MB -> 0.35 min/MB      80 MB -> 0.22 min/MB
    // Projected wall for this 592 MB query: 20 MB -> 56 min, 40 MB -> 31 min,
    // 80 MB -> 36 min. Concurrency is bound by MEMORY (~114 GB/task at 40 MB), so
    // lower diamond_block_size if more parallel tasks are ever wanted.
    diamond_chunk_size    = 40.MB

    // ===========================
    // Haplotig purging (03b)
    // ===========================
    // calcuts' transition between haploid and diploid depth. null = automatic cutoffs.
    // Set it when the depth histogram has no valley between the two peaks (one merged
    // peak): calcuts cannot place the transition then. About 0.6x the depth peak.
    // Lower/upper: null = calcuts' automatic values.
    purge_dups_transition = null
    purge_dups_lower      = null
    purge_dups_upper      = null

    // ===========================
    // Contamination screens (03c) and scaffolding (03d)
    // ===========================
    run_screens           = true
    univec                = null          // UniVec_Core FASTA
    fcs_gx_db             = null          // FCS-GX database directory (all.gxi, all.gxs, ...)
    fcs_adaptor_image     = null          // ncbi/fcs-adaptor .sif (run with apptainer exec; the image has no bash)
    fcs_gx_image          = null          // ncbi/fcs-gx .sif
    fcs_tax_id            = null          // NCBI taxid of the organism for FCS-GX; must be in the GX database
    // Decisions on the unclear screen hits (FCS-GX REVIEW, VecScreen Strong/Moderate):
    // TSV seq, start, end, decision (exclude | mask | keep), reason. The run stops and
    // lists the undecided hits in 03c_screens/contigs/review/screen_review.tsv.
    screen_decisions      = null
    scaffold_reference    = null          // reference genome FASTA for RagTag; null = no scaffolding
    ragtag_infer_gaps     = false         // RagTag -r (gap sizes from the reference)
    ragtag_args           = null          // further `ragtag.py scaffold` options

    // ===========================
    // Gene-model refinement (07c)
    // ===========================
    run_haplotig_scan     = true          // near-identical copies on chromosome scaffolds (DIAMOND all-vs-all)
    n_chromosome_scaffolds = null         // chromosome-scale scaffolds are scaffold_1..N after sorting; null = none
    related_proteomes     = null          // directory, one protein FASTA per related species: gap-fusion split
    gap_split_min_species = 2             // split a fused model when >= this many proteomes support it
    gap_split_min_cov     = 0.6           // ... each half covering >= this fraction of its reference protein
    refine_keep_mirna     = false         // keep Rfam miRNA models (needs small-RNA evidence to be credible)
    refine_frame_min      = 0.9           // codon-frame agreement to keep two transcripts in one gene
    refine_repeat_max     = 0.5           // drop ncRNAs more than this fraction inside interspersed repeats
    refine_haplotig_pid   = 98            // possible_haplotig_of: identity ...
    refine_haplotig_qcov  = 0.8           // ... and query coverage of the copy
    transcript_edits      = null          // optional TSV of manual transcript edits (drop / corrected CDS), see bin/refine_annotation.py
    isoform_filter        = true          // remove alternative isoforms without evidence of their own (needs related_proteomes), see bin/isoform_filter.py
    isoform_min_reads     = 3             // RNA-seq reads for an intron to count as supported (also the gap-split remnant test)
    isoform_cov_diff      = 0.1           // homolog-cover difference (fraction of the related protein) that favours one isoform
    isoform_start_tol     = 5             // aa: a protein start matches a related protein's start within this distance
    isoform_short_exon    = 15            // bp: internal CDS exons up to this length need evidence when an isoform lacks them

    // ===========================
    // Release (10): NCBI submission files, QC gate, release folder
    // ===========================
    run_release           = false         // optional stage; when on, the NCBI settings below are required
    release_name          = 'release'     // folder <outdir>/release/<release_name>/
    release_version       = '1.0'
    release_notes         = null          // markdown appended to the README as "Known limitations"
    table2asn             = null          // NCBI table2asn Linux binary (or its .gz download)
    rm_libraries          = null          // RepeatMasker Libraries/ dir (Dfam partitions) for RepeatClassifier
    symbiont_busco_lineage = null         // BUSCO lineage (dir or .tar.gz) for the symbiont bin; null = skip
    product_draft         = null          // optional TSV symbol -> product, used instead of the UniProt lookup
    product_cache         = null          // UniProt lookup cache (uniprot_cache.json) from an earlier run: cached symbols are not queried again
    uniprot_offline       = false         // true: product names from product_cache only, no UniProt queries (a symbol missing from the cache fails)
    product_lookup_all    = false         // true: look up every gene with a symbol in UniProt, not only suspect names (no entry: name kept)
    strip_gene_suffix     = false         // true: remove funannotate's '_N' suffix from gene symbols in the submission and release files
    release_folder_suffix = ''            // added to the release and summary output folders (e.g. '_full' for a second release from the same cache)
    // NCBI (required with run_release; ncbi_isolate or ncbi_strain, one of the two)
    bioproject            = null          // BioProject accession (PRJNA...)
    biosample             = null          // BioSample accession (SAMN...)
    ncbi_species          = null          // organism name exactly as in the BioSample
    ncbi_isolate          = null
    ncbi_strain           = null
    locus_tag             = null          // registered locus-tag prefix
    ncbi_sbt              = null          // submission template (.sbt)
    ncbi_cmt              = null          // structured comment(s) for table2asn -w
    ncbi_lineage          = null          // only if table2asn cannot reach NCBI taxonomy
    ncbi_linkage_evidence = null          // scaffold-gap linkage evidence (NCBI term, e.g. align-genus, proximity-ligation);
                                          // null = align-genus with scaffold_reference (RagTag), otherwise unspecified
    // QC gate expectations
    qc_expected_lineage   = 'Eukaryota'   // every .sqn lineage must start with this
    qc_expected_division  = null          // e.g. 'INV'
    qc_chrom_prefix       = null          // chromosome scaffolds must map to names with this prefix (e.g. 'NC_')

    // ===========================
    // Stage toggles
    // ===========================
    run_genomescope       = true
    run_mitogenome        = true
    run_repeats           = true
    // QC checkpoint after contamination filtering (gfastats + BUSCO). The
    // post-purge_dups checkpoint is NOT optional -- blobtools needs that BUSCO
    // table -- but this one is pure measurement, so it can be turned off.
    run_assembly_checkpoints = true
    // Before/after polishing QC (Merqury QV + BUSCO + gfastats) and the gate that
    // keeps the UNPOLISHED assembly if polishing degraded it. Turning this off also
    // skips building the read k-mer database on the --input_assembly path.
    run_polish_qc         = true
    // Tolerances for that gate. A metric may drop by at most this much before the
    // unpolished assembly is kept: QV in raw QV points, BUSCO in percentage points.
    polish_qv_tolerance   = 0.5
    polish_busco_tolerance = 0.5
    run_structural_annotation = true
    run_functional_annotation = true
    skip_porechop         = false
    skip_symbiont_filter  = false
    skip_blobtools        = false
    blobtools_plots       = true   // static blob/snail/cumulative PNGs of the stage's final output (filtered host BlobDir, or unfiltered if no filter) -> 03_filtering/plots

    // ===========================
    // Resources — params consumed directly by process definitions
    // ===========================
    threads_default       = 32
    threads_busco         = 32

    // --- 03_filtering: BLASTN / DIAMOND ---
    // Both are chunked, so these are threads PER TASK and concurrency comes from
    // the executor's slots.
    //
    // Do not oversubscribe the node: diamond's ref-histogram phase takes 72-137 s
    // at 32 threads and 2485 s at 280 threads on a 256-core node.
    // 8 concurrent tasks x 32 threads = 256 cores exactly, and 8 is also where
    // memory caps concurrency (~114 GB/task of 950 GB).
    threads_diamond       = 32
    threads_blastn        = 32

    // diamond seed-index tuning. Reference is 32.0 Gletters, so
    // block_size 12 -> ceil(32/12) = 3 blocks, index_chunks 1 -> 3 index
    // passes total (defaults 2.0/4 give 16 x 4 = 64). Memory is roughly
    // 6 x block_size GB, i.e. ~72 GB here. Do not raise block_size so far
    // that resident memory starts evicting the cached nt/dmnd databases.
    diamond_block_size    = 12
    diamond_index_chunks  = 1
    // diamond spills intermediates; keep them off the rotational array
    // that holds the Nextflow work dir.
    diamond_tmpdir        = '/tmp'

    // Hits fed to the per-taxon bitscore sum in BLOBTOOLS_ADD_HITS (top N
    // by bitscore). blobtools' default is 10, which is too low once the
    // big scaffolds are windowed: ~475 windows x up to 10 hits each means
    // the 10 highest-scoring alignments can all come from one conserved
    // region. ~500 lets roughly one hit per window contribute so the call
    // reflects the scaffold's overall composition. Small contigs are
    // unaffected -- they only ever produce ~10 hits.
    blobtools_hit_count   = 500
    threads_star          = 48
    threads_braker        = 128
    threads_funannotate   = 80
    // InterProScan and funannotate annotate both scale with CPUs (one job per CPU;
    // funannotate runs Pfam/dbCAN hmmsearch, diamond, BUSCO, SignalP in parallel).
    // They never run at the same time (annotate waits for InterProScan). Note: x attempt
    // means a retry asks for 480, above the local 260 cap (fine on a larger cluster).
    threads_interproscan          = 240
    threads_funannotate_annotate  = 240

    // NECAT
    resource_necat_memory = 256.GB
    resource_necat_cpus   = 64
    resource_necat_time   = 48.h

    // Flye
    resource_flye_memory  = 256.GB
    resource_flye_cpus    = 64
    resource_flye_time    = 24.h
    // Flye polishing iterations. Flye's own docs say more than ~2 rarely helps;
    // 10 was a large wall-clock cost for effectively nothing. 4 keeps some margin.
    iteration_flye        = 4
    // Metagenome mode -- see the comment in modules/02_multi_assembler.nf.
    flye_meta             = true

    // hifiasm
    resource_hifiasm_memory = 256.GB
    resource_hifiasm_cpus   = 64
    resource_hifiasm_time   = 48.h

    // Raven
    resource_raven_memory = 128.GB
    resource_raven_cpus   = 64
    resource_raven_time   = 12.h

    // Polishing (04_assembly_polish.nf)
    // Medaka consensus model. null -> auto-detect from the ONT read headers'
    // basecall_model_version_id and validate it; the process FAILS rather than
    // guessing if that metadata is missing. Set explicitly to override, e.g.
    // 'r1041_e82_400bps_hac_v4.3.0'. See `medaka tools list_models`.
    medaka_model                = null
    resource_medaka_memory      = 32.GB
    resource_medaka_time        = 12.h
    resource_busco_final_memory = 64.GB
    resource_busco_final_time   = 48.h

    // Structural annotation (07_structural_annotation.nf)
    resource_braker_memory = 128.GB
    resource_braker_time   = 72.h

    // Functional annotation (08_functional_annotation.nf)
    resource_iprscan_memory     = 64.GB
    resource_iprscan_time       = 48.h
    resource_eggnog_memory      = 64.GB
    resource_eggnog_time        = 24.h
    resource_funannotate_memory = 128.GB
    resource_funannotate_time   = 48.h

    // ===========================
    // Executor / SLURM
    // ===========================
    project               = null
    publish_mode          = 'copy'
    // Intermediates (alignments, per-chunk search output, staged query fasta).
    // 'symlink' avoids copying hundreds of GB out of the work dir.
    // IMPORTANT: on an HPC whose work dir is purgeable scratch, symlinks become
    // dangling -- set this to 'copy' there, or accept that these are regenerable.
    publish_mode_intermediate = 'symlink'
    max_retries           = 3

    // ===========================
    // Container strategy
    // ===========================

    // Apptainer/Singularity image cache (binac2)
    apptainer_cache_dir   = "/pfs/10/project/apptainer_cache/${System.getenv('USER')}"

    // Email, sent by the workflow.onComplete handler at the bottom of this file.
    //   email            -- always send a completion summary here
    //   email_on_failure -- send only when the run fails
    email                 = null
    email_on_failure      = false

    // Timestamp suffix for the execution timeline/report/trace/dag filenames so
    // successive runs do not overwrite each other's reports. Not a user knob --
    // it lives here only because the config parser forbids a local `def`.
    trace_report_suffix   = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// ===========================
// Global process defaults
//
// RETRY POLICY -- retry only what is worth retrying.
//
// A DETERMINISTIC failure (a bad flag, a missing file, a wrong output path) fails
// fast instead of being retried at escalating resources.
//
// Exit codes 130-145 are the fatal signals (137 = SIGKILL/OOM-killer,
// 143 = SIGTERM/scheduler walltime), 104 and 247 are the out-of-memory codes
// some schedulers report. Those are worth retrying with more resources, because
// the `memory { X * task.attempt }` closures grow the request each attempt.
// Anything else fails fast.
// ===========================
process {
    errorStrategy = { task.exitStatus in ((130..145).toList() + [104, 247]) ? 'retry' : 'finish' }
    maxRetries    = params.max_retries
}

// ===========================
// Pipeline metadata
// ===========================
manifest {
    name            = 'ID-por-genome'
    author          = 'ColinL1'
    description     = 'Coral (Porites) genome assembly and annotation pipeline'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    // resourceLimits (used by the binac2 profile) requires 24.04 or newer.
    nextflowVersion = '>=24.04.0'
}

// ===========================
// Execution reporting
//
// These four reports are the empirical basis for all resource tuning -- without
// them, per-process cost is guesswork. `peak_rss` in particular is what sizes
// DIAMOND_BLASTX's concurrency: its memory footprint, not its thread count, is
// what caps how many chunks can run at once (see modules/03_assembly_filtering.nf).
//
// Filenames carry params.trace_report_suffix (a launch timestamp) so successive
// runs do not overwrite each other's reports -- important when comparing a
// tuning change against its baseline. The suffix lives in `params` rather than a
// local `def` because Nextflow's config parser rejects variable declarations
// mixed with config statements.
// ===========================
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    fields  = 'task_id,hash,native_id,process,tag,status,exit,container,cpus,memory,time,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,rchar,wchar,read_bytes,write_bytes'
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

/*
 * ===========================
 * PROFILE: binac2
 * SLURM + Apptainer (production HPC)
 * ===========================
 */
profiles {
    binac2 {
        process {
            executor       = 'slurm'
            clusterOptions = { params.project ? "-A ${params.project}" : "-p compute" }
            queue          = 'compute'
            resourceLimits = [
                memory: 2000.GB,
                cpus:   128,
                time:   336.h
            ]
        }

        executor {
            queueSize         = 200
            submitRateLimit   = '50/2min'
            pollInterval      = 10.s
            queueStatInterval = 1.m
        }

        apptainer {
            enabled     = true
            autoMounts  = true
            pullTimeout = 40.m
            cacheDir    = params.apptainer_cache_dir
        }
    }

    /*
     * ===========================
     * PROFILE: local
     * Local executor + Apptainer (development/testing)
     * ===========================
     */
    local {
        process {
            executor = 'local'
        }

        // NOTE: `cpus` inside a `process` scope sets the DEFAULT REQUEST for
        // every process that does not declare its own -- it is not a machine
        // cap. The node-level limits belong in the `executor` scope.
        //
        // These are also what bound concurrency for memory-hungry steps: given
        // an honest `memory` directive, `memory = '950 GB'` is what stops too
        // many DIAMOND_BLASTX chunks running at once.
        executor {
            cpus   = 260
            // memory = '950 GB'
        }

        apptainer {
            enabled = true
        }
    }

    /*
     * ===========================
     * PROFILE: test
     * Minimal settings for `-stub` CI runs. Exercises the full DAG, including
     * the optional stages, without needing real data, databases or container pulls.
     *
     *   nextflow run . -stub -profile test
     *
     * Resources are tiny because stub tasks do no work; the point is that every
     * process's declared outputs and channel wiring are satisfied.
     * ===========================
     */
    test {
        process {
            executor = 'local'

            // MUST be a withName selector, not the bare `process` scope. A
            // directive set in the `process` scope is only a DEFAULT for processes
            // that do not get it from a label or selector, so `process { cpus = 1 }`
            // would be inert here. Selectors DO override.
            withName: '.*' {
                cpus   = 1
                memory = 1.GB
                time   = 10.m
            }

            // A stub failure is a real failure -- never paper over it with retries.
            errorStrategy = 'terminate'
            maxRetries    = 0
        }

        executor {
            cpus   = 4
            memory = '8 GB'
        }

        apptainer.enabled = false
        conda.enabled     = false

        params {
            ont_raw_reads             = "${projectDir}/assets/test/reads.fastq.gz"
            // Exercise every optional stage.
            run_genomescope           = true
            run_mitogenome            = true
            run_repeats               = true
            run_structural_annotation = true
            run_functional_annotation = true
            run_polish_qc             = true
            // Keep the licence-restricted / data-hungry steps off, as in production.
            run_phobius               = false
            interproscan_data         = null
            // Screens, RagTag, gap-fusion scan and an NCBI release: dummy inputs in assets/test/
            // (stub tasks only need them to exist).
            run_screens               = true
            univec                    = "${projectDir}/assets/test/univec.fa"
            fcs_gx_db                 = "${projectDir}/assets/test/fcs_gx_db"
            fcs_adaptor_image         = "${projectDir}/assets/test/fcs-adaptor.sif"
            fcs_gx_image              = "${projectDir}/assets/test/fcs-gx.sif"
            fcs_tax_id                = 1
            scaffold_reference        = "${projectDir}/assets/test/reference.fa"
            purge_dups_transition     = 10
            related_proteomes         = "${projectDir}/assets/test/related_proteomes"
            n_chromosome_scaffolds    = 2
            run_release               = true
            table2asn                 = "${projectDir}/assets/test/table2asn"
            symbiont_busco_lineage    = "${projectDir}/assets/test/symbiont_lineage"
            ncbi_species              = 'Testus sp.'
            ncbi_isolate              = 'T1'
            locus_tag                 = 'TEST'
            bioproject                = 'PRJNA000000'
            biosample                 = 'SAMN00000000'
            ncbi_sbt                  = "${projectDir}/assets/test/template.sbt"
            ncbi_cmt                  = "${projectDir}/assets/test/structured_comment.cmt"
        }
    }

    /*
     * ===========================
     * PROFILE: conda
     * Local executor + conda envs (every process declares a `conda`
     * directive), for iterating on a machine without Apptainer.
     *
     * Apptainer remains the supported container system for real runs. This is
     * for quick local iteration only and is NOT what production uses.
     * ===========================
     */
    conda {
        process {
            executor = 'local'
        }

        executor {
            cpus   = 260
            // memory = '950 GB'
        }

        conda {
            enabled  = true
            useMamba = true
            cacheDir = "${projectDir}/.conda_envs"
        }

        apptainer.enabled = false
    }
}

// ===========================
// Completion handler
//
// Reports the outcome, the timing, and where to find the integrated report,
// so a long HPC run does not have to be babysat.
// ===========================
workflow.onComplete = {
    def status  = workflow.success ? 'SUCCEEDED' : 'FAILED'
    def report  = "${params.outdir}/summary/multiqc/multiqc_report.html"
    def summary = """
    ------------------------------------------------------------
    ${workflow.manifest.name ?: 'pipeline'} ${workflow.manifest.version ?: ''} -- ${status}
    ------------------------------------------------------------
    Run name     : ${workflow.runName}
    Session      : ${workflow.sessionId}
    Duration     : ${workflow.duration}
    Completed at : ${workflow.complete}
    Command line : ${workflow.commandLine}
    Work dir     : ${workflow.workDir}
    Results      : ${params.outdir}
    MultiQC      : ${report}
    Exit status  : ${workflow.exitStatus}
    ${workflow.success ? '' : "Error report : ${workflow.errorReport ?: 'n/a'}"}
    ------------------------------------------------------------
    """.stripIndent()

    // NOTE: `log` is null inside a config closure -- use println here.
    println summary

    // Only mail when asked to, and when the outcome matches what was asked for.
    def wants_mail = params.email && (workflow.success ? !params.email_on_failure : true)
    if (wants_mail) {
        try {
            sendMail(to: params.email,
                     subject: "[${workflow.manifest.name ?: 'pipeline'}] ${status}: ${workflow.runName}",
                     body: summary)
        }
        catch (Exception e) {
            // A mail failure must never mask the pipeline's own outcome.
            println "WARN: could not send completion email to ${params.email}: ${e.message}"
        }
    }
}

workflow.onError = {
    println "ERROR: pipeline failed at: ${workflow.errorMessage ?: 'unknown step'}"
}
