//example config file, will be modified in final release

params {
    // ===========================
    // Core inputs
    // ===========================
    ont_raw_reads         = 'All_allrun.fastq.gz'
    outdir                = 'results'
    symbiont_refs         = null          // comma-separated paths, or null → auto-download
    symbiont_taxids       = '58267'       // Symbiodiniaceae NCBI taxon ID
    coverage_refs         = null          // comma-separated paths, or null → auto-download
    coverage_taxid        = 46719         // Porites NCBI taxon ID
    taxon_id              = 46719         // Default taxon ID for BlobTools
    mito_ref              = "${projectDir}/config/mito-Plut_OY283138.1.fasta"          // path to mitogenome ref, or null → auto-download from taxon_id
    mito_taxid            = 31689         // Coral mitochondrial reference (Scleractinia)
    rnaseq_dir            = "${projectDir}/config/rna_dir"
    trimmomatic_adapters  = "${projectDir}/config/all_truseq_edited.fasta"
    protein_refs          = "${projectDir}/config/coral_proteins_ncbi.faa"
    genomescope_script    = "${projectDir}/config/bin/genomescope.R"
    bin_path    = "${projectDir}/config/bin/"

    // ===========================
    // Assembly
    // ===========================
    assemblers            = ['necat','flye','hifiasm','raven'] //['necat']     // ['necat','flye','hifiasm','raven']
    necat_config          = "${projectDir}/config/necat_config"
    necat_path_bin        = "${projectDir}/config/bin/NECAT/Linux-amd64/bin"
    necat_read_list       = "${projectDir}/config/necat_read_list.txt"
    genome_size           = null          // auto-detected from k-mer if null
    kmer_size             = 21
    min_coverage          = 2

    // ===========================
    // Annotation
    // ===========================
    busco_lineage         = 'anthozoa_odb12'
    busco_offline_dir     = null //"${projectDir}/config/busco_db"   // path to local BUSCO lineage datasets, or null → online download
    rnaseq_strandedness   = 'unstranded'        // 'unstranded' | 'forward' | 'reverse' | 'auto'
    funannotate_db        = "${projectDir}/config/funannotate_DB"
    species_name          = 'Porites_sp'        // overridden by --species_name

    // ===========================
    // Stage toggles
    // ===========================
    run_genomescope       = true
    run_mitogenome        = true
    run_repeats           = true
    run_structural_annotation = true
    run_functional_annotation = true
    skip_porechop         = false         // true → use raw reads directly, skip adapter trimming
    skip_symbiont_filter  = false
    skip_blobtools        = false

    // ===========================
    // Resources — params consumed directly by process definitions
    // in modules/*.nf (cpus/memory/time set in-process)
    // ===========================
    threads_default       = 16
    threads_busco         = 16
    threads_star          = 32
    threads_braker        = 32
    threads_funannotate   = 32

    // NECAT
    resource_necat_memory = 256.GB
    resource_necat_cpus   = 32
    resource_necat_time   = 48.h

    // Flye
    resource_flye_memory  = 128.GB
    resource_flye_cpus    = 16
    resource_flye_time    = 24.h
    iteration_flye        = 10

    // hifiasm
    resource_hifiasm_memory = 256.GB
    resource_hifiasm_cpus   = 32
    resource_hifiasm_time   = 48.h

    // Raven
    resource_raven_memory = 64.GB
    resource_raven_cpus   = 16
    resource_raven_time   = 12.h

    // ===========================
    // Executor / SLURM
    // ===========================
    project               = null
    publish_mode          = 'copy'
    enable_resume         = true
    max_retries           = 3

    // ===========================
    // Container strategy
    // ===========================
    prefer_apptainer      = true

    // Email
    email                 = null
    email_on_failure      = false
}

// ===========================
// Notification settings
// ===========================
notification {
    enabled = params.email != null
    to      = params.email
    from    = params.email
}

// ===========================
// Global process defaults
// publishDir is now set per-process in modules/*.nf, organized by
// pipeline stage and tool (e.g. results/02_assembly/busco/), so no
// flat/global publishDir default is defined here to avoid double-
// publishing every output into both a flat and an organized location.
// ===========================

executor {
    // Local development runs; overridden in the binac2 profile
    queueSize = 8
}

profiles {
    /*
     * ===========================
     * PROFILE: local
     * Local executor + Docker (development/testing)
     * ===========================
     */
    local {
        process {
            executor = 'local'
            cpus = 180
        }

    conda {
        enabled   = false
        useMamba = true
    }

        docker {
            enabled    = false
            runOptions = '-u $(id -u):$(id -g)'
        }

        apptainer {
            enabled = true
        }
    }
}

